    onDialogueStart:
      m_PersistentCalls:
        m_Calls: []
    onDialogueEnd:
      m_PersistentCalls:
        m_Calls: []
  - dialogueID: floorboard_locked
    lines:
    - text: The floor boards here are squeaky and loose. I'm suprised my dad let
        them get this bad.
      speakerName: 
      speakerPortrait: {fileID: 0}
      voiceClip: {fileID: 0}
