  dialogueDatabase:
  - dialogueID: '"vulture"'
    lines:
    - text: I don't remember this one... It's got the price tag on it still.
      speakerName: 
      speakerPortrait: {fileID: 0}
      voiceClip: {fileID: 0}
      displayTime: 0
      requirePlayerInput: 0
      onLineStart:
