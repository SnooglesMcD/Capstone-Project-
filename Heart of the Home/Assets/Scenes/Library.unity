  - dialogueID: '"evil_eye"'
    lines:
    - text: It feels smooth and cold to the touch. I always wondered why they call
        it an "evil eye" if it's supposed to protect you.
      speakerName: 
      speakerPortrait: {fileID: 0}
      voiceClip: {fileID: 0}
      displayTime: 0
      requirePlayerInput: 0
