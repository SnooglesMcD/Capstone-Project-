    onDialogueEnd:
      m_PersistentCalls:
        m_Calls: []
  - dialogueID: '"key"'
    lines:
    - text: The floor boards here are squeaky and loose. I'm suprised my dad let
        them get this bad.
      speakerName: 
      speakerPortrait: {fileID: 0}
      voiceClip: {fileID: 0}
      displayTime: 0
