  - dialogueID: '"toybox_interact"'
    lines:
    - text: 'Dad was... particular about me cleaning up my playroom. He engineered
        one of his crazy machines so that the basement door wouldn''t open unless
        all my toys were put away. '
      speakerName: 
      speakerPortrait: {fileID: 0}
      voiceClip: {fileID: 0}
      displayTime: 1
      requirePlayerInput: 0
      onLineStart:
        m_PersistentCalls:
